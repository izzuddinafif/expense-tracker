# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Notion Integration Token (https://www.notion.so/my-integrations)
# Must be from the workspace where your "Budget & Expense Tracker (IDR)" template lives
NOTION_TOKEN=

# Required before saving Notion tokens in SQLite. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up this key separately; losing it makes encrypted tokens unrecoverable.
TOKEN_ENCRYPTION_KEY=

# Gmail address and App Password for bank email watching
# App Password: enable 2FA first, then create at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional overrides (defaults shown)
# VISION_MODEL=openrouter/free
# QUERY_MODEL=openrouter/free
# EMAIL_POLL_INTERVAL=300
# EMAIL_OWNER=Afif          # Name of the user whose Gmail inbox is watched (must match a name in config.py users dict)

# Personal Android API. Leave API_TOKEN blank to disable the API.
# API_TOKEN=
# API_USER_ID=               # Telegram user ID owning the canonical ledger
# API_MAX_BODY_BYTES=65536

# Security: only these Telegram IDs may use the bot. If omitted, the IDs in
# TELEGRAM_USERS are used. Required in webhook mode.
# TELEGRAM_ALLOWED_IDS=123456789

# Telegram webhook mode. Leave WEBHOOK_DOMAIN blank to use long polling.
# The domain must serve a publicly trusted TLS certificate at the reverse proxy;
# the Python container itself listens on plain HTTP.
# WEBHOOK_DOMAIN=https://expense.example.com
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# PORT=8080
